---
import katex from 'katex';
import { withSuppressedKatexMetricWarnings } from '../../lib/katex-silence.mjs';

interface Props {
  formula: string;
  block?: boolean;
}

const { formula, block = false } = Astro.props;

const html = withSuppressedKatexMetricWarnings(() => {
  return katex.renderToString(formula, {
    displayMode: block,
    throwOnError: false,
  });
});
---

<span class="math-formula" set:html={html} />
